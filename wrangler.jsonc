{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexo-creative",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexo-crm-db",
      "database_id": "nexo-crm-db"
    }
  ],
  "observability": {
    "enabled": true
  }
}
