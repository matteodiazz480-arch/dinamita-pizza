# ============================================================================
# NEXO CREATIVE — Variables de Entorno (EJEMPLO)
# Nunca subas el archivo .env real al repositorio ni uses el prefijo VITE_
# para claves privadas o secretos del servidor.
# ============================================================================

# Clave secreta del servidor para firmar tokens CSRF y saltear hashes de IP (32+ bytes hex)
CSRF_SECRET=reemplazar_por_cadena_aleatoria_de_64_caracteres_hexadecimales

# Contraseña maestra de acceso al CRM (Por defecto: nexo2026admin)
CRM_PASSWORD=nexo2026admin

# ----------------------------------------------------------------------------
# Cloudflare D1 Database (Opcional - si no se configuran, utiliza JSONL en disco)
# ----------------------------------------------------------------------------
# 1. CLOUDFLARE_ACCOUNT_ID: ID de tu cuenta en Cloudflare (Panel principal -> barra lateral derecha)
CLOUDFLARE_ACCOUNT_ID=

# 2. CLOUDFLARE_D1_DATABASE_ID: UUID de tu base de datos D1 (Storage & Databases -> D1 -> UUID)
CLOUDFLARE_D1_DATABASE_ID=

# 3. CLOUDFLARE_API_TOKEN: Token de API de Cloudflare con permisos de D1 Edit (My Profile -> API Tokens)
CLOUDFLARE_API_TOKEN=

# Clave privada de proveedor externo de IA (Opcional — solo accesible en backend)
AI_PROVIDER_API_KEY=

# Webhook privado para notificaciones internas de formularios (Opcional — solo backend)
INTERNAL_LEAD_WEBHOOK_URL=
