# ==============================================================================
# NEXO CREATIVE — Variables de Entorno del Proyecto (.env / Vercel Settings)
# ==============================================================================

# 1. CONTRASEÑA DE ACCESO ADMINISTRATIVO AL CRM
# Contraseña segura para ingresar al panel del CRM (por defecto: nexo2026admin)
CRM_PASSWORD=nexo2026admin

# 2. SEGURIDAD DEL SERVIDOR Y TOKENS CSRF
# Secreto criptográfico aleatorio para firma de cookies seguras y tokens de sesión
SERVER_SECRET=a8f9c3e210b45d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e

# 3. CONEXIÓN A BASE DE DATOS CLOUDFLARE D1 (Opcional para nube)
# Si estas 3 variables están configuradas, los leads y reuniones se guardan en Cloudflare D1.
# Si no están configuradas, el sistema almacena automáticamente en disco seguro (JSONL).
CLOUDFLARE_ACCOUNT_ID=tu_account_id_de_cloudflare
CLOUDFLARE_D1_DATABASE_ID=tu_d1_database_id_uuid
CLOUDFLARE_API_TOKEN=tu_cloudflare_api_token_con_permisos_d1_edit
